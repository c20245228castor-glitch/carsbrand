<section
    id="contact"
    class="scroll-mt-8 rounded-lg bg-white p-8 text-left shadow-sm dark:bg-gray-800"
>
    <div class="mx-auto max-w-2xl">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400">
            Get in touch
        </p>

        <h2 class="mb-4 text-3xl font-bold">Let’s find your next car</h2>

        <p class="mb-6 text-gray-600 dark:text-gray-300">
            Have a question about a car or need help with your search? Send us a message.
        </p>

        <form action="#" class="grid gap-4">
            <input
                type="text"
                name="name"
                placeholder="Your Name"
                aria-label="Your name"
                class="rounded-lg border border-gray-300 bg-transparent p-3 outline-none focus:border-black dark:border-gray-600 dark:focus:border-white"
            />

            <input
                type="email"
                name="email"
                placeholder="Your Email"
                aria-label="Your email"
                class="rounded-lg border border-gray-300 bg-transparent p-3 outline-none focus:border-black dark:border-gray-600 dark:focus:border-white"
            />

            <textarea
                id="message"
                name="message"
                placeholder="Your Message"
                rows="5"
                required
                aria-label="Your message"
                class="rounded-lg border border-gray-300 bg-transparent p-3 outline-none focus:border-black dark:border-gray-600 dark:focus:border-white"
            ></textarea>

            <button
                type="submit"
                class="w-fit rounded-md bg-black px-5 py-3 font-semibold text-white transition hover:bg-gray-700 dark:bg-white dark:text-black dark:hover:bg-gray-200"
            >
                Send Message
            </button>
        </form>
    </div>
</section>
