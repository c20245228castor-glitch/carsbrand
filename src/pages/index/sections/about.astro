---
---

<section
	id="about"
	class="grid scroll-mt-8 items-center gap-10 text-left lg:grid-cols-2"
>
	<div>
		<p class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400">
			Find your drive
		</p>
		<h1 class="mb-5 text-4xl font-bold tracking-tight sm:text-5xl">
			A better road to your next car.
		</h1>
		<p class="mb-6 leading-relaxed text-gray-600 dark:text-gray-300">
			Explore cars for every kind of journey, from comfortable everyday
			sedans to spacious SUVs and all-electric drives.
		</p>
		<div class="flex flex-wrap gap-3">
			<a
				href="#contact"
				class="rounded-md border border-gray-300 px-5 py-3 font-semibold text-black no-underline transition hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:border-gray-600 dark:text-white dark:hover:bg-gray-800"
			>
				Contact us
			</a>
		</div>
	</div>

	<div class="grid grid-cols-2 gap-3">
		<figure class="overflow-hidden rounded-lg">
			<img
				src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=900&q=85"
				alt="Modern car parked outdoors"
				class="h-64 w-full object-cover"
				loading="lazy"
			/>
			<figcaption class="py-2 text-sm font-medium">
				Cars for everyday drives
			</figcaption>
		</figure>

		<div class="grid gap-3">
			<figure class="overflow-hidden rounded-lg">
				<img
					src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=900&q=85"
					alt="Sleek sports car on the road"
					class="h-32 w-full object-cover"
					loading="lazy"
				/>
				<figcaption class="py-2 text-sm font-medium">
					Performance and style
				</figcaption>
			</figure>

			<figure class="overflow-hidden rounded-lg">
				<img
					src="https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?auto=format&fit=crop&w=900&q=85"
					alt="Car driving along an open road"
					class="h-32 w-full object-cover"
					loading="lazy"
				/>
				<figcaption class="py-2 text-sm font-medium">
					Ready for the next journey
				</figcaption>
			</figure>
		</div>
	</div>
</section>
