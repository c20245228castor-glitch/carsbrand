---
import BaseLayout from "../../../layout/BaseLayout.astro";
---

<BaseLayout title="Find a car | Carsbrand">
	<div class="space-y-10">
		<section class="mx-auto max-w-3xl text-center">
			<p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">
				Carsbrand inventory
			</p>
			<h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">
				Find a car for every kind of drive.
			</h1>
			<p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">
				Explore our featured vehicles, compare details, and check the
				example listing prices.
			</p>
		</section>

		<section
			class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
			aria-label="Featured car listings"
		>
			<article class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
				<img
					src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1200&q=85"
					alt="Silver sedan parked outdoors"
					class="h-56 w-full object-cover"
					loading="lazy"
				/>
				<div class="p-5">
					<p class="mb-1 text-sm text-gray-500 dark:text-gray-400">
						2024 · Sedan · Automatic
					</p>
					<h2 class="text-xl font-bold">Everyday Sedan</h2>
					<p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
						A comfortable, fuel-efficient sedan with room for daily
						commutes and weekend trips.
					</p>
					<p class="mt-4 text-2xl font-bold">$24,900</p>
					<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
						Example listing price
					</p>
				</div>
			</article>

			<article class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
				<img
					src="https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?auto=format&fit=crop&w=1200&q=85"
					alt="SUV ready for a road trip"
					class="h-56 w-full object-cover"
					loading="lazy"
				/>
				<div class="p-5">
					<p class="mb-1 text-sm text-gray-500 dark:text-gray-400">
						2023 · SUV · Automatic
					</p>
					<h2 class="text-xl font-bold">Family SUV</h2>
					<p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
						A spacious SUV with flexible cargo room and seating for
						your next family adventure.
					</p>
					<p class="mt-4 text-2xl font-bold">$31,500</p>
					<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
						Example listing price
					</p>
				</div>
			</article>

			<article class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
				<img
					src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1200&q=85"
					alt="Sporty coupe on the road"
					class="h-56 w-full object-cover"
					loading="lazy"
				/>
				<div class="p-5">
					<p class="mb-1 text-sm text-gray-500 dark:text-gray-400">
						2024 · Coupe · Automatic
					</p>
					<h2 class="text-xl font-bold">Sport Coupe</h2>
					<p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
						A sleek coupe with responsive handling and a
						driver-focused interior.
					</p>
					<p class="mt-4 text-2xl font-bold">$38,750</p>
					<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
						Example listing price
					</p>
				</div>
			</article>
		</section>

		<a
			class="mx-auto block w-fit font-semibold underline underline-offset-4 hover:text-gray-600 dark:hover:text-gray-300"
			href="/"
		>
			← Back to home
		</a>
	</div>
</BaseLayout>
