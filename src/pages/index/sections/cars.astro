---
import BaseLayout from "../../../layout/BaseLayout.astro";
---

<BaseLayout title="Find a car | Carsbrand">
	<div class="space-y-10">
		<section class="mx-auto max-w-3xl text-center">
			<p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">
				Carsbrand inventory
			</p>
			<h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">
				Find a car for every kind of drive.
			</h1>
			<p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">
				Explore our featured vehicles, compare details, and check the
				example listing prices.
			</p>
		</section>

		<section
			class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
			aria-label="Featured car listings"
		>
			<article class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
				<img
					src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTOtqAqhTD6eI7ts0yJWxxnt753qXRx_47-USEe9n2LjA&s=10"
					alt="Silver hilux parked outdoors"
					class="h-56 w-full object-cover"
					loading="lazy"
				/>
				<div class="p-5">
					<p class="mb-1 text-sm text-gray-500 dark:text-gray-400">
						2026· Hilux· Automatic
					</p>
					<h2 class="text-xl font-bold">Suv Hilux</h2>
					<p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
						A comfortable, fuel-efficient SUV with room for daily
						commutes and weekend trips.
					</p>
					<p class="mt-4 text-2xl font-bold">$24,900</p>
					<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
						Example listing price
					</p>
				</div>
			</article>

			<article class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
				<img
					src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSKpCXa_dXFo5EfkGJcAZcWO66v5Utqbn8xlcTVuhjyyw&s=10"
					alt="SUV ready for a road trip"
					class="h-56 w-full object-cover"
					loading="lazy"
				/>
				<div class="p-5">
					<p class="mb-1 text-sm text-gray-500 dark:text-gray-400">
						2026 · Mitsubishi · Automatic
					</p>
					<h2 class="text-xl font-bold">Mitsubishi Montero</h2>
					<p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
						Toyota Motor Philippines announces an upgrade to its
						Zenix MPV for 2027 upgrading its luxury and technology
						features in the process.
					</p>
					<p class="mt-4 text-2xl font-bold">$31,500</p>
					<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
						Example listing price
					</p>
				</div>
			</article>

			<article class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
